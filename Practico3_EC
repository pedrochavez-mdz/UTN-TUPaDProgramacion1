if 8 <= regla <= 14:
    print("Ha ingresado una contraseña correcta.")
else:
    print("Por favor, ingrese una contraseña de entre 8 y 14 caracteres.")

# Actividad 6: El paquete statistics de python contiene funciones que permiten tomar una lista de números y calcular la moda, la mediana y la media de dichos números. 
import random
from statistics import mode, median, mean
numeros_aleatorios = [random.randint(1, 100)for i in range(50)]
promedio = mean(numeros_aleatorios)
mitad = median(numeros_aleatorios)
repetido = mode(numeros_aleatorios)
print(f"El promedio (media) es: {promedio}")
print(f"El dato del centro (mediana) es: {mitad}")
print(f"El que más se repite (moda) es: {repetido}")
print("-" * 30)
if promedio > mitad > repetido:
    print("Resultado: Sesgo positivo (a la derecha).")
elif promedio < mitad < repetido:
    print("Resultado: Sesgo negativo (a la izquierda).")
else:
    print("Resultado: No tiene sesgo (distribuciòn simétrica).")

